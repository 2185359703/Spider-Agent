APP_ENV=local
# AUTO_SPIDER_BASE_IMAGE=python:3.12-slim
DATABASE_URL=mysql+pymysql://auto_spider:auto_spider@mysql:3306/auto_spider?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
EVIDENCE_ROOT=/srv/auto_spider/evidence
WORKTREE_ROOT=/srv/auto_spider/worktrees
COLLECTOR_SOURCE_REPO_PATH=/srv/collector-source
COLLECTOR_SOURCE_REPO_HOST_PATH=D:/Project/Auto_spider_repositories/fun-crawler-v2
AICODING_REPO_PATH=/srv/aicoding-collector
AICODING_REPO_HOST_PATH=D:/Project/Auto_spider_repositories/aicoding-auto_spider
COLLECTOR_SOURCE_BASELINE_REF=16cba8439396e371973e4ee0301d3a88f2f32ba5
AICODING_BASELINE_REF=c932dbac4bb75df04008c85d3560c1b7a28ec211
AICODING_REMOTE_URL=https://gitee.com/daxia-com/auto_spider.git
AICODING_PUSH_ENABLED=false
OPENHANDS_LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
OPENHANDS_LLM_BASE_URL=
OPENHANDS_LLM_API_MODE=auto
AI_GATEWAY_PROFILE=default
# OpenCode Zen profile; credentials stay only in local .env.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_API_MODE=chat
OPENCODE_API_KEY=
OPENHANDS_SERVER_URL=http://openhands-agent-server:8000
OPENHANDS_WORKSPACE_ROOT=/srv/auto_spider/worktrees
OPENHANDS_SESSION_API_KEY=
OPENHANDS_LLM_API_KEY=
OPENHANDS_SECRET_KEY=
AGENT_MODE=openhands
ANALYSIS_MODE=browser
AUTH_MODE=dev
# AUTH_MODE=header 时，API 要求 X-User-Id / X-User-Role；角色为 viewer/operator/reviewer/admin
AUTO_SPIDER_EAGER_WORKFLOW=false
QUEUE_ENABLED=true
# 本机按单任务运行；需要更高并发时再提高，并同步调整容器内存预算。
WORKER_CONCURRENCY=1
# 构建串行执行；只限制 Compose 并行调用，不代表 BuildKit 的内存上限。
COMPOSE_PARALLEL_LIMIT=1
MAX_REPAIR_ATTEMPTS=3
# 接入规范在生成代码前最多自动纠正两次；重投继续原轮次，历史证据保留。
MAX_SPEC_REPAIR_ATTEMPTS=2
# 单次执行的控制与超时预算；人工等待不占用 worker。
EXECUTION_LEASE_SECONDS=60
EXECUTION_HEARTBEAT_SECONDS=5
EXECUTION_TIMEOUT_SECONDS=3600
AGENT_MAX_ITERATIONS=100
AGENT_POLL_SECONDS=2
AGENT_POLICY_ROOT=./agent_policies
AGENT_BROWSER_ENABLED=true
